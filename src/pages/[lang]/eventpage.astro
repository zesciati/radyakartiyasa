---
import "bootstrap/dist/css/bootstrap.min.css";
import "bootstrap-icons/font/bootstrap-icons.css";
import Eventpagelayout from "../../layouts/Eventpagelayout.astro";
import EventHero from "../../components/event/event-hero.astro";
import EventLeftSide from "../../components/event/event-left-side.astro";
import EventRightSide from "../../components/event/event-right-side.astro";
import EventFoto from "../../components/event/event-foto.astro";
const pageTitle = "Event Page Layout 🚀";


export function getStaticPaths () {
return [
    {params: {lang: 'id-ID'}},
    {params: {lang: 'en-EN'}},
  ];
}

const { lang } = Astro.params;
---

<Eventpagelayout pageTitle={pageTitle}>
  <EventHero />
  <EventLeftSide />
  <EventRightSide />
  <EventFoto />
</Eventpagelayout>

