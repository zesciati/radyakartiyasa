---
import "bootstrap/dist/css/bootstrap.min.css";
import "bootstrap-icons/font/bootstrap-icons.css";
import Eventpagelayout from "../../layouts/Eventpagelayout.astro";
import EventHero from "../../components/event/event-hero.astro";
import EventDescription from "../../components/event/event-description.astro";
import EventInformation_sidebar from "../../components/event/event-information_sidebar.astro";
import EventAccesibilities from "../../components/event/event-accessibilities.astro";
import EventIsiacara from "../../components/event/event-isi-acara.astro";
const pageTitle = "Event Page Layout 🚀";


export function getStaticPaths () {
return [
    {params: {lang: 'id-ID'}},
    {params: {lang: 'en-EN'}},
  ];
}

const { lang } = Astro.params;
---

<Eventpagelayout pageTitle={pageTitle}>
  <EventHero />
  <EventDescription />
  <EventAccesibilities />
  <EventIsiacara />
</Eventpagelayout>

