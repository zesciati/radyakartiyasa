---
import "bootstrap/dist/css/bootstrap.min.css";
import "../../styles/event/event-foto.css/";
import 'bootstrap-icons/font/bootstrap-icons.css';
---

<div style="width: 100%; background-color: #ccc; height: 1px;"></div>
  
  <!-- 3 Foto -->
  <div class="container my-5">
    <h2 class="mb-4">Event lainnya dari museum Kraton Yogyakarta</h2>
    <div class="row">
        <!-- Card 1 -->
        <div class="col-sm-12 col-md-4">
          <div class="card">
            <img src="./img/keraton.webp" class="card-img-top" alt="Jelajah Museum Karaton Yk">
            <div class="card-body p-0">
              <div class="row">
                <div class="col-md-4" style="text-align: center;">
                  <h5 style="color: #f7b24d;">NOV</h5>
                  <h4>25 - 26</h4>
                </div>
                <div class="col-md-8">
                  <strong class="card-title">Jelajah Museum Karaton Yk</strong>
                <p class="card-text">Adventure Geek - Explore the Unexplored</p>
                <p class="card-text"><small class="text-muted">8:30 AM - 7:30 PM</small></p>
                <p class="card-text"><i class="bi bi-ticket-detailed me-2"></i>IDR 250.000</p>
                </div>
              </div>
            </div>
          </div>
        </div>
        <!-- Card 2 -->
        <div class="col-sm-12 col-md-4">
