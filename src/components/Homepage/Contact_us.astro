<section class="contact-section py-5 w-75 rounded-2" style="margin-left: 10%;">
  <div class="header">
    <span class="contact-label" style="font-size: 10px"> TERHUBUNG </span>
  </div>
  
  <!-- Main Content -->
  <div class="container mt-2">
    <div class="row">
      <!-- Left Column -->
      <div class="col-lg-6 left-column">
        <span class="contact-label" style="font-size: 10px"> TERHUBUNG </span>
        <h3 class="heading lebih" style="color: #DEE0FF; font-size: 25px;">Berikan Kesan dan Pesan <br> Anda pada form yang <br> disediakan</h3>
        <br>
        <p>
          Kami dengan senang hati akan menjawab pertanyaan Anda dan
          membantu Anda menentukan layanan mana yang paling sesuai dengan kebutuhan Anda.
        </p>
        <p><strong>Hubungi kami di: (0274) 373721</strong></p>
        <p>
          <strong>Lokasi kami</strong><br>
          Jl. Rotowijayan Blok No. 1, Panembahan,<br>
          Kecamatan Kraton, Kota Yogyakarta,<br>
          Daerah Istimewa Yogyakarta
        </p>
      </div>
  
      <!-- Right Column (Form) -->
      <div class="col-lg-6" style="margin-top: 10px;">
        <div class="info-card p-3 rounded" style="font-size: 12px; width: 90%;">
          <form>
            <div class="mb-3">
              <label for="name" class="form-label">Nama</label>
              <input type="text" class="form-control" id="name" placeholder="Isikan nama lengkap Anda">
            </div>
            <div class="mb-3">
              <label for="email" class="form-label">Email</label>
              <input type="email" class="form-control" id="email" placeholder="Isikan dengan email aktif Anda">
            </div>
            <div class="mb-3">
              <label for="profession" class="form-label">Profesi Anda</label>
              <input type="text" class="form-control" id="profession" placeholder="Pilih profesi Anda saat ini">
            </div>
  
            <div class="mb-3">
              <label for="phone" class="form-label">No. Handphone</label>
              <input type="tel" class="form-control" id="phone" placeholder="Isikan dengan nomor handphone aktif">
            </div>
  
            <div class="mb-3">
              <label for="message" class="form-label">Pesan</label>
              <textarea class="form-control" id="message" rows="4" placeholder="Tuliskan pesan disini ..."></textarea>
            </div>
  
            <button type="submit" class="btn btn-dark btn-submit">Kirim Pesan</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<script
  src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"
>
  import "bootstrap/dist/js/bootstrap.bundle.min.js";
</script>
